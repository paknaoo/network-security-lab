alert tcp $ATTACKER_NET any -> $HOME_NET any (msg:"LOCAL Possible TCP SYN port scan from attacker segment"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 15, seconds 3; classtype:attempted-recon; sid:9000001; rev:2;)
alert http $ATTACKER_NET any -> $HTTP_TARGET any (msg:"LOCAL Nikto-style web scanner User-Agent detected"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; classtype:web-application-attack; sid:9000002; rev:1;)
alert http $ATTACKER_NET any -> $HTTP_TARGET any (msg:"LOCAL Suspicious request to sensitive path"; flow:established,to_server; http.uri; content:"/.env"; classtype:web-application-attack; sid:9000003; rev:1;)
alert http $ATTACKER_NET any -> $HTTP_TARGET any (msg:"LOCAL Path traversal attempt detected"; flow:established,to_server; http.uri.raw; content:"../"; classtype:web-application-attack; sid:9000004; rev:2;)
alert dns $ATTACKER_NET any -> any any (msg:"LOCAL Suspicious DNS query to known exfil domain"; dns.query; content:"exfil-test.example.com"; nocase; classtype:bad-unknown; sid:9000005; rev:2;)
alert dns $ATTACKER_NET any -> any any (msg:"LOCAL Possible DNS tunneling - high volume queries from single source"; threshold:type both, track by_src, count 15, seconds 5; classtype:bad-unknown; sid:9000006; rev:1;)
